NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ==== BACKEND PYTHON (KHÔNG public, chỉ set trong Vercel Environment Variables) ====
SUPABASE_URL=https://afyvbjmidjccbnwfldgf.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://afyvbjmidjccbnwfldgf.supabase.co/auth/v1/.well-known/jwks.json

# ==== THÔNG BÁO (tùy chọn - để trống nếu chưa tích hợp) ====
ZALO_OA_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=

# ==== BÁO CÁO TUẦN GỬI PHỤ HUYNH QUA EMAIL (chỉ backend) ====
# Không dùng tiền tố NEXT_PUBLIC_ cho các biến này.
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-school-account@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Thông báo nhà trường

# Nếu có tên miền riêng, có thể đổi EMAIL_PROVIDER=resend và dùng hai biến sau.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Thông báo nhà trường <thongbao@tenmiencuatruong.vn>
